    <string name="toggle_show_text_preview">Show text indicator</string>
    <string name="toggle_hint_show_text_preview">Shows several lines of text around the cursor in the keyboard\'s top bar.</string>
    <string name="toggle_disable_left_hints">Disable all left-side hints</string>
    <string name="toggle_hint_disable_left_hints">Hides group markers, letter hints, and repeat/delete bubbles. Cursor buttons and gesture-zone boundaries remain visible.</string>
    <string name="toggle_disable_right_hints">Disable right-side hints</string>
    <string name="toggle_hint_disable_right_hints">Hides the circular hint and touch-point indicator; right-side gestures continue to work.</string>
    <string name="toggle_micro_vibration">Micro vibration for keys</string>
    <string name="toggle_hint_micro_vibration">Short, gentle pulse: 12 ms at strength 22/255, if the device supports vibration strength control.</string>
    <string name="toggle_normal_vibration">Regular key vibration (minimum)</string>
    <string name="toggle_hint_normal_vibration">A slightly longer pulse: 16 ms at strength 40/255 when supported; otherwise the system default strength is used.</string>
    <string name="toggle_delete_space_symbol">Delete space before a quick symbol</string>
    <string name="toggle_hint_delete_space_symbol">If a space precedes a quick symbol, the keyboard deletes it before inserting the symbol.</string>
    <string name="toggle_number_row">Persistent number row at the top</string>
    <string name="toggle_hint_number_row">Shows numbers above the main keyboard. The number layout on the symbols page is unchanged.</string>
    <string name="toggle_space_after_symbol">Add a space after a quick symbol</string>
    <string name="toggle_hint_space_after_symbol">Automatically inserts a space after a symbol selected on the right panel.</string>
    <string name="toggle_auto_capitalization">Auto-capitalize at the start of a sentence</string>
    <string name="toggle_hint_auto_capitalization">Capitalizes the first letter at the start of text and after a period, exclamation mark, or question mark.</string>
    <string name="toggle_key_repeat">Repeat action while holding</string>
    <string name="toggle_hint_key_repeat">Holding Backspace repeats deletion automatically. Cursor movement buttons repeat independently of this switch.</string>
    <string name="toggle_repeat_last_symbol">Repeat the last symbol while holding</string>
    <string name="toggle_hint_repeat_last_symbol">Hold your left finger in the repeat zone to repeat the last entered symbol.</string>

